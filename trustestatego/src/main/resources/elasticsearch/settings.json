{
  "max_ngram_diff": 20,
  "analysis": {
    "analyzer": {
      "custom_index_analyzer": {
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding",
          "ngram_filter"
        ]
      },
      "custom_search_analyzer": {
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "asciifolding"
        ]
      }
    },
    "filter": {
      "ngram_filter": {
        "type": "ngram",
        "min_gram": 2,
        "max_gram": 20
      }
    }
  }
}
